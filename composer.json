{
	"name": "saizul/woo-performance-toolkit",
	"description": "Trim WooCommerce overhead: cart fragments, front-end assets, heartbeat, scheduled database cleanup and diagnostics.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"homepage": "https://github.com/saizul/woo-performance-toolkit",
	"authors": [
		{
			"name": "Saizul Amin",
			"homepage": "https://saizul.com"
		}
	],
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5",
		"wp-coding-standards/wpcs": "^3.0",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1"
	},
	"autoload": {
		"psr-4": {
			"SaizulAmin\\WooPerformanceToolkit\\Integration\\": "includes/",
			"SaizulAmin\\WooPerformanceToolkit\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"SaizulAmin\\WooPerformanceToolkit\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit",
		"lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
		"phpcs": "phpcs"
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
